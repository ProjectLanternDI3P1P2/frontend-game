{
  "name": "project-lantern-public-site",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "cypress run",
    "test:e2e:open": "cypress open",
    "test": "npm run test:unit && npm run test:e2e",
    "assets:dungeon": "node scripts/dungeon-atlas/build.mjs",
    "assets:audio": "node scripts/audio/build.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "keycloak-js": "^26.2.4",
    "nuxt": "^4.7.0",
    "oxlint-tsgolint": "^7.0.2002",
    "vue": "^3.5.0",
    "vue-router": "^5.5.3",
    "web-vitals": "^5.0.0"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.0.0",
    "@types/jest": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.6.0",
    "axe-core": "^4.10.0",
    "cypress": "^15.0.0",
    "cypress-axe": "^1.6.0",
    "eslint": "^9.0.0",
    "eslint-plugin-vuejs-accessibility": "^2.4.1",
    "happy-dom": "^21.0.4",
    "sass": "^1.105.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "3.5.3",
    "sass-embedded": "^1.83.0",
    "typescript": "^5.7.0",
    "vitest": "^5.1.2",
    "vue-tsc": "^3.0.0"
  },
  "overrides": {
    "archiver": {
      "readdir-glob": "^4.0.0"
    },
    "js-beautify": {
      "editorconfig": "^4.0.1",
      "glob": "^14.0.6"
    }
  },
  "allowScripts": {
    "cypress@15.21.1": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true,
    "@parcel/watcher@2.6.0": true
  },
  "lint-staged": {
    "*.{js,mjs,ts,vue}": "eslint --fix",
    "*": "prettier --write --ignore-unknown"
  },
  "version": "0.3.0"
}
