# Optional: copy to .env.compose, then use docker compose --env-file .env.compose ...
GAME_PORT=3000
PUBLIC_PORT=3001
# Used only by compose.backend.yaml (Traefik, never a direct microservice port).
API_PORT=8088
KEYCLOAK_PORT=8081
# Local Keycloak admin account. Change both before exposing the stack.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
# Local development credentials. Changing them does not update existing volumes.
POSTGRES_PASSWORD=lantern-admin-local
SERVICE_DB_PASSWORD=lantern-local
RABBITMQ_PASSWORD=lantern-local

# Target gRPC dependencies: deadlines, no automatic retries.
PLAYER_DUNGEON_GRPC_TIMEOUT_SECONDS=5
DUNGEON_COMBAT_GRPC_TIMEOUT_SECONDS=5
DUNGEON_REWARDS_GRPC_TIMEOUT_SECONDS=5
COMBAT_PLAYER_GRPC_TIMEOUT_SECONDS=5
COMBAT_REWARDS_GRPC_TIMEOUT_SECONDS=5
COMBAT_DUNGEON_GRPC_TIMEOUT_SECONDS=5
GRPC_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
GRPC_CIRCUIT_BREAKER_BREAK_SECONDS=30
RABBITMQ_PREFETCH_COUNT=16
LOG_LEVEL=Information

# Reserved for instrumentation; enable only with a reachable collector.
OTEL_SDK_DISABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=none
OTEL_TRACES_SAMPLER=parentbased_always_on
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=local,service.namespace=lantern

# For compose.github-packages.yaml, set GITHUB_PACKAGES_CREDENTIALS
# in the invoking shell (Username=<login>;Password=<token>;ValidAuthenticationTypes=Basic).
# Never commit the token.
