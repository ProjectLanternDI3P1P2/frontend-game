    {
      "name": "rewards.events",
      "vhost": "/",
      "type": "topic",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    },
    {
      "name": "progression.events",
      "vhost": "/",
      "type": "topic",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    },
    {
      "name": "lantern.dead-letter",
      "vhost": "/",
      "type": "direct",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    }
  ],
  "queues": [
    {
      "name": "player.events.v1",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "quorum"
      }
    },
    {
      "name": "player.events.v1.dead",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "quorum"
      }
    },
    {
      "name": "rewards.events.v1",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "quorum"
      }
    },
    {
      "name": "rewards.events.v1.dead",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "quorum"
      }
    }
  ],
  "bindings": [
    {
      "source": "dungeon.events",
      "vhost": "/",
      "destination": "player.events.v1",
      "destination_type": "queue",
      "routing_key": "dungeon.dungeon-run-ended.v1",
      "arguments": {}
    },
    {
      "source": "lantern.dead-letter",
      "vhost": "/",
      "destination": "player.events.v1.dead",
      "destination_type": "queue",
      "routing_key": "player.events.v1",
      "arguments": {}
    },
    {
      "source": "combat.events",
      "vhost": "/",
      "destination": "rewards.events.v1",
      "destination_type": "queue",
      "routing_key": "combat.consumable-used.v1",
      "arguments": {}
    },
    {
      "source": "lantern.dead-letter",
      "vhost": "/",
      "destination": "rewards.events.v1.dead",
      "destination_type": "queue",
      "routing_key": "rewards.events.v1",
      "arguments": {}
    }
  ],
  "policies": [
    {
      "vhost": "/",
      "name": "player.events.v1",
      "pattern": "^player\\.events\\.v1$",
      "apply-to": "quorum_queues",
      "priority": 10,
      "definition": {
        "delivery-limit": 5,
        "dead-letter-exchange": "lantern.dead-letter",
        "dead-letter-routing-key": "player.events.v1",
        "dead-letter-strategy": "at-least-once",
        "overflow": "reject-publish",
        "message-ttl": 604800000
      }
    },
    {
      "vhost": "/",
      "name": "rewards.events.v1",
      "pattern": "^rewards\\.events\\.v1$",
      "apply-to": "quorum_queues",
      "priority": 10,
      "definition": {
        "delivery-limit": 5,
        "dead-letter-exchange": "lantern.dead-letter",
        "dead-letter-routing-key": "rewards.events.v1",
        "dead-letter-strategy": "at-least-once",
        "overflow": "reject-publish",
        "message-ttl": 604800000
      }
    }
  ]
}
