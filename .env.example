# ADR-FE-004 / ADR-FE-011 — every business call goes through the API Gateway.
NUXT_PUBLIC_API_GATEWAY_URL=http://localhost:8080
NUXT_PUBLIC_API_VERSION=v1

# Public browser metadata. Set SITE_URL to the externally reachable HTTPS URL
# in each deployed environment; it is used for the canonical link.
NUXT_PUBLIC_APP_NAME=game-client
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# ADR-FE-013 — platform endpoint that collects errors and Web Vitals.
# Left empty, the reporter is inert: nothing is queued and nothing is sent.
NUXT_PUBLIC_TELEMETRY_ENDPOINT=

# Build identity required by the cycle 1 / week 2 delivery gate.
NUXT_PUBLIC_APP_VERSION=dev
NUXT_PUBLIC_COMMIT_SHA=local
NUXT_PUBLIC_BUILT_AT=local
